# Copy to .env for local dev; set these as secrets in Cloud Functions for
# deploy. NEVER commit the real .env — it is gitignored.

# The Gemini API key. Paid tier (prompts not used for training). Restrict it to
# the Generative Language API in the Cloud Console.
GEMINI_API_KEY=your-key-here

# Optional model override. Defaults to gemini-2.5-flash-lite.
GEMINI_MODEL=gemini-2.5-flash-lite

# Phase 3: set to "true" to make a valid App Check token mandatory. Leave unset
# during Phase 1 local testing.
ENFORCE_APP_CHECK=false
