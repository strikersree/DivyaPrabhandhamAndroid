<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Needed by Google Drive sync and by the in-app recitation player. Its
      absence was invisible: DriveAppData wraps its calls in runCatching, so the
      SecurityException this permission's absence throws was swallowed and sync
      simply never worked.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Daily reading reminders (API 33+ asks at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arm reminders after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Play Billing for the tip jar. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!--
      Advertising ID, for AdMob. The Google Mobile Ads SDK already merges this
      in, so the built artifact has always carried it — but only since the ads
      dependency landed, and versionCode 10 was published both before and after
      that, so the copy live on Play was built without it. Play Console then
      warned that the AD_ID declaration did not match the artifact, and a zeroed
      advertising id breaks ad serving. Declared here explicitly so it is
      visible in this repo and survives any future change to the ads dependency
      rather than being an invisible side effect of one. Duplicate uses-permission
      entries are merged, so this adds nothing to the built manifest.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!--
      Android 11+ hides other packages unless declared. RecitationLauncher
      checks for these two so it can send playback straight to the app rather
      than bouncing the listener into a browser tab.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.amazon.mp3" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".DivyaPrabhandhamApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.DivyaPrabhandham.Splash">

        <!--
          Required by the Google Mobile Ads SDK — its absence is a hard crash
          on init ("Missing application ID"), not a soft failure. This is
          Google's own published SAMPLE_APP_ID, the same placeholder shown in
          AdMob's official quick-start guide, safe to ship as-is since it only
          ever serves test ads. TODO: replace with the real AdMob app ID once
          the app is registered in the AdMob console — see ads/AdConfig.kt,
          which needs its own three real ad unit IDs at the same time.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/Theme.DivyaPrabhandham.Splash">

            <!-- The launcher entry lives on the activity-aliases below, one per
                 app-icon variant; MainActivity itself is only the target. -->

            <!-- Deep links from the widget and the reminder notification.
                 Mirrors the iOS `divyaprabhandham://` custom scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="divyaprabhandham" />
            </intent-filter>
        </activity>

        <!-- App-icon variants as launcher aliases. Exactly one is enabled at a
             time; the runtime switch (from onboarding / Settings) toggles which.
             Default is the Vadakalai icon; the Thenkalai alias starts disabled.
             The alias name strings are frozen — they are referenced by the
             component-toggling code and must not change. -->
        <activity-alias
            android:name=".MainActivityVadakalai"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityThenkalai"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_thenkalai"
            android:roundIcon="@mipmap/ic_launcher_thenkalai"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Hourly verse widget (Glance). -->
        <receiver
            android:name=".widget.VerseWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/verse_widget_info" />
        </receiver>

        <!-- Fires a scheduled daily reminder. -->
        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />

        <!-- Fires the sparse tip-jar nudge, for someone who has been away. -->
        <receiver
            android:name=".notify.SupportReminderReceiver"
            android:exported="false" />

        <!-- Re-schedules reminders after reboot, since AlarmManager alarms
             do not survive one. -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            Serves the rendered pasuram cards to whichever app the person
            picks out of the share sheet. grantUriPermissions with
            FLAG_GRANT_READ_URI_PERMISSION on the intent means the receiving
            app gets read access to that one file and nothing else, for as
            long as it holds the URI; exported=false keeps anything that was
            not handed a URI out entirely.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
